# ══════════════════════════════════════════════════════════════
#  teslamate-supercharger-costs — configuration
#  Copy this file to .env and fill in your values.
#  Never commit .env to version control!
# ══════════════════════════════════════════════════════════════

# ── Tesla API mode ─────────────────────────────────────────────
# fleet     = official Tesla Fleet API (recommended, see README)
# ownership = legacy unofficial endpoint (Tesla seems to have dropped it)
# Default: "fleet" if TESLA_CLIENT_ID is set, otherwise "ownership".
TESLA_API_MODE=fleet

# ── Tesla Fleet API (TESLA_API_MODE=fleet) ─────────────────────
# From your app at https://developer.tesla.com
TESLA_CLIENT_ID=your-client-id
TESLA_CLIENT_SECRET=your-client-secret
# Must exactly match an "Allowed Redirect URI" of your app.
TESLA_REDIRECT_URI=https://localhost/callback
# Region of your Tesla account: eu (Europe), na (North America / Asia-Pacific)
TESLA_FLEET_REGION=eu
# Where the Fleet API token is stored (map /data to a host volume!)
TESLA_FLEET_TOKEN_FILE=/data/fleet_token.json

# ── Tesla ownership API (TESLA_API_MODE=ownership, legacy) ─────
# TESLA_EMAIL=your@email.com
# TESLA_CACHE_FILE=/data/tesla_cache.json

# ── Vehicles ───────────────────────────────────────────────────
# (Optional) Limit the import to specific vehicles, comma-separated.
# If not set, ALL vehicles on the account are imported. Each session
# is matched to the TeslaMate car with the same VIN.
# TESLA_VIN=5YJ3E7EB0KF000000,LRW3E7FS0NC000000

# ── TeslaMate database ─────────────────────────────────────────
# The hostname must match the service name in your TeslaMate
# docker-compose.yml (usually "database").
TESLAMATE_DB_HOST=database
TESLAMATE_DB_PORT=5432
TESLAMATE_DB_NAME=teslamate
TESLAMATE_DB_USER=teslamate
TESLAMATE_DB_PASS=your_database_password_here

# ── Importer behaviour ─────────────────────────────────────────
# How many days back to fetch from the Tesla API on each run.
# For a nightly cron run 7 is plenty (one API request per car).
# Increase for a one-time historical backfill (e.g. 365).
LOOKBACK_DAYS=7

# Maximum difference in seconds between Tesla API start time
# and TeslaMate's recorded start time to count as a match.
# Increase to 300 if you see many "NOT FOUND" warnings.
TIME_TOLERANCE_S=120

# Set to "true" to overwrite costs that TeslaMate already has.
# Useful if you want to force a re-import of corrected data.
OVERWRITE_EXISTING=false


# ── Logging ────────────────────────────────────────────────────
LOG_FILE=/logs/importer.log

# ── Currency conversion ────────────────────────────────────────
# Convert all Supercharger costs to a single currency before saving.
# Uses live exchange rates from the European Central Bank (no API key needed).
# Supported: EUR, CHF, CZK, USD, GBP, PLN, HUF, NOK, SEK, DKK, ...
# Leave empty to store costs in their original local currency.
# TARGET_CURRENCY=CHF
